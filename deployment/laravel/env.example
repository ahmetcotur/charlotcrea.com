# Copy to deployment/laravel/.env (ignored by Git); set unique secrets.
APP_URL=https://cms.example.com
APP_KEY=
POSTGRES_PASSWORD=
POSTGRES_DB=charlot
POSTGRES_USER=charlot
HTTP_PORT=8092
IMAGE_TAG=local
SITE_INDEXABLE=false
SESSION_SECURE_COOKIE=true
# Keep log until the SMTP provider is configured and tested.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@charlotcrea.com
ADMIN_NOTIFICATION_EMAIL=info@charlotcrea.com

ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90
TRUSTED_PROXIES=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
